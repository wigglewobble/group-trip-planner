generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())

  tripsAsAdmin  Trip[]        @relation("TripAdmin")
  memberships   TripMember[]
}

model Trip {
  id            String     @id @default(uuid())
  name          String
  destination   String
  startDate     DateTime
  endDate       DateTime
  status        TripStatus @default(PLANNING)
  adminId       String
  needsReplan   Boolean    @default(false)
  replanReason  String?
  createdAt     DateTime   @default(now())

  admin       User         @relation("TripAdmin", fields: [adminId], references: [id])
  members     TripMember[]
  itineraries Itinerary[]
}

model TripMember {
  id           String   @id @default(uuid())
  tripId       String
  userId       String
  status       MemberStatus @default(INVITED)
  budget       Float?
  interests    String[]
  energyLevel  String?
  travelStyle  String?
  hasSubmitted Boolean  @default(false)
  joinedAt     DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}


model Itinerary {
  id        String   @id @default(uuid())
  tripId    String
  data      Json
  version   Int      @default(1)
  votes     Json     @default("{}")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

enum TripStatus {
  PLANNING
  READY
  REPLANNING
}

enum MemberStatus{
  INVITED
  ACCEPTED
  DECLINED
}